{
  "name": "agent-memory-wiki",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=24 <27",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "build": "pnpm --filter @agent-memory-wiki/web build",
    "dev": "pnpm --filter @agent-memory-wiki/web dev",
    "lint": "eslint .",
    "migrate": "pnpm --filter @agent-memory-wiki/db migrate",
    "test": "vitest",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "eslint": "10.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
