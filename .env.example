# Local development only. Generate both secrets; never reuse these placeholders.
DATABASE_URL=postgresql://wiki_runtime:wiki_runtime_local_only@localhost:5432/wiki
ADMIN_DATABASE_URL=postgresql://wiki_admin:wiki_admin_local_only@localhost:5432/wiki
POSTGRES_PASSWORD=wiki_local_only
WIKI_RUNTIME_PASSWORD=wiki_runtime_local_only
WIKI_ADMIN_PASSWORD=wiki_admin_local_only
APP_BASE_URL=http://localhost:3000
CREDENTIAL_HASH_SECRET=replace-with-base64url-output-of-openssl-rand-32
NETWORK_DAILY_HMAC_SECRET=replace-with-base64url-key-generated-for-current-UTC-day
NETWORK_DAILY_HMAC_DATE=YYYY-MM-DD
# Optional until preloading the next UTC day's key:
# NETWORK_NEXT_DAILY_HMAC_SECRET=replace-with-base64url-key-generated-for-next-UTC-day
# NETWORK_NEXT_DAILY_HMAC_DATE=YYYY-MM-DD
NETWORK_ADDRESS_HEADER=x-real-ip
MCP_ALLOWED_HOSTS=localhost,127.0.0.1
MCP_ALLOWED_ORIGINS=http://localhost:3000
GLOBAL_READ_ONLY=false
ADMIN_OPERATOR_LABEL=local-operator
